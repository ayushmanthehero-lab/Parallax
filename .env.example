# PARALLAX server configuration. Copy to .env.local; keep real secrets private.
# Never prefix credentials with NEXT_PUBLIC_. Never commit .env.local.
# For the local Compose stack, run node scripts/docker-setup.mjs instead.
# It creates a separate private .env.docker.local; see deploy/local/README.md.

# Local engine: run npm run db in a separate terminal.
# For a different directory, launch with PARALLAX_DB_PATH and update this socket.
FALKORDB_SOCKET=/tmp/parallax-falkordb/redis.sock

# Optional self-hosting: HTTPS gateway + actual FalkorDB on a persistent volume.
# Railway supplies compute and disk; FalkorDB remains the graph database.
# When present, FALKORDB_HTTP_URL takes precedence over the socket and TCP.
# Use the origin only: no path, credentials, query string or fragment.
# FALKORDB_HTTP_URL=https://your-graph-gateway.up.railway.app
# FALKORDB_GATEWAY_TOKEN=

# Selected hosted route: direct FalkorDB Cloud through the official client.
# Railway is not used in this route.
# Remove/comment FALKORDB_HTTP_URL and FALKORDB_SOCKET when selecting this path.
# Copy the exact hostname (no URL scheme), port and credentials from the instance.
# Public production requires a TLS-enabled endpoint. Match its actual TLS setting.
# FALKORDB_HOST=
# FALKORDB_PORT=
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_TLS=true
# FALKORDB_PERSISTENCE=managed
# Use "managed" only when the instance's storage guarantees are confirmed.
# Cloud TLS/persistence features depend on the selected plan; this flag adds none.

# Required on Vercel: generate a unique private random value, at least 32 characters.
# A stable value also preserves local visitor continuity across app restarts.
PARALLAX_SESSION_SECRET=

# Optional API access gate: requests must send x-parallax-access-token.
# This is not an interactive browser login or an organization role system.
# Leave absent for the public synthetic demonstration.
# PARALLAX_ACCESS_TOKEN=

# Choose guided, vercel-gateway, or openai-compatible.
# With no provider and no LLM_API_KEY, guided mode is explicitly labeled.
# PARALLAX_AI_PROVIDER=guided

# Vercel AI Gateway: set PARALLAX_AI_PROVIDER=vercel-gateway.
# Deployed requests obtain fresh OIDC identity through @vercel/oidc.
# AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# Optional for local use instead of deployed OIDC:
# AI_GATEWAY_API_KEY=

# Direct model: set PARALLAX_AI_PROVIDER=openai-compatible.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini

# Optional external MCP: requires this bearer token AND a valid session cookie.
# Internal MCP tools do not need the public route enabled.
# PARALLAX_MCP_TOKEN=
